# ==============================================================================
# Mangari - Variáveis de Ambiente de Configuração (.env)
# ==============================================================================

# Chave secreta de sessão do Flask (gere uma chave forte e única para produção)
SECRET_KEY=dev-secret-key-change-in-production-only

# URL de conexão com o banco de dados
# Exemplo MySQL (XAMPP padrão sem senha):
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/mangari_db
# Exemplo MySQL com senha:
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/mangari_db
# Exemplo SQLite local (desenvolvimento/testes):
# DATABASE_URL=sqlite:///mangari_dev.db

# Integração com APIs Externas
ANILIST_API_URL=https://graphql.anilist.co

# Diretório de armazenamento seguro de capítulos (fora de app/static/)
STORAGE_DIR=storage/manga

# Limites de Tamanho e Segurança de Arquivos (valores em bytes / números)
# Limite máximo da requisição HTTP (padrão: 100 MB)
MAX_UPLOAD_SIZE=104857600
# Limite máximo de arquivos compactados ZIP/CBZ (padrão: 90 MB)
MANGA_MAX_ARCHIVE_SIZE=94371840
# Limite máximo de imagens por capítulo
MANGA_MAX_IMAGES=1000
# Limite máximo de conteúdo descompactado para prevenção de Zip Bombs (padrão: 500 MB)
MANGA_MAX_EXTRACTED_SIZE=524288000

